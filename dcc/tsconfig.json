{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "web",
    "outDir": "../.local/dcc/compiled/web",
    "moduleDetection": "legacy"
  },
  "include": ["web/**/*.ts", "types.d.ts"]
}
